{
  "entities": {
    "Ledger": {
      "title": "Ledger",
      "description": "Buku kas (wallet ledger) milik pengguna.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Nama buku kas" },
        "description": { "type": "string", "description": "Deskripsi buku kas" },
        "icon": { "type": "string" },
        "colorAccent": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "createdAt"]
    },
    "Account": {
      "title": "Account",
      "description": "Akun/rekening keuangan dan kantong (pockets) dalam buku kas.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["bank", "ewallet", "cash", "credit_card"] },
        "balance": { "type": "number" },
        "creditLimit": { "type": "number" },
        "colorAccent": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "pockets": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "type", "balance", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi pemasukan, pengeluaran, atau transfer.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "accountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "goalId": { "type": "string" },
        "billId": { "type": "string" },
        "debtId": { "type": "string" },
        "automationId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "accountId", "type", "amount", "date", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Target tabungan (wishlist atau sinking fund).",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["wishlist", "sinking_fund"] },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "sourceAccountId": { "type": "string" },
        "colorAccent": { "type": "string" },
        "note": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "type", "targetAmount", "currentAmount", "createdAt"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Tagihan rutin berkala.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "cycle": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly", "custom"] },
        "customIntervalCount": { "type": "number" },
        "customIntervalUnit": { "type": "string", "enum": ["days", "weeks", "months", "years"] },
        "pricingType": { "type": "string", "enum": ["fixed", "variable"] },
        "fixedAmount": { "type": "number" },
        "lastNominal": { "type": "number" },
        "nextPaymentDate": { "type": "string" },
        "category": { "type": "string" },
        "sourceAccountId": { "type": "string" },
        "totalPaid": { "type": "number" },
        "colorAccent": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "cycle", "pricingType", "nextPaymentDate", "totalPaid", "createdAt"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Utang dan cicilan pengguna.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "lender": { "type": "string" },
        "totalDebt": { "type": "number" },
        "remainingDebt": { "type": "number" },
        "nextPaymentDate": { "type": "string" },
        "cycle": { "type": "string" },
        "customIntervalCount": { "type": "number" },
        "customIntervalUnit": { "type": "string" },
        "dueDate": { "type": "string" },
        "sourceAccountId": { "type": "string" },
        "colorAccent": { "type": "string" },
        "note": { "type": "string" },
        "isPaidOff": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "totalDebt", "remainingDebt", "isPaidOff", "createdAt"]
    },
    "AutomationRule": {
      "title": "AutomationRule",
      "description": "Aturan transaksi otomatis (auto-income, auto-expense, auto-transfer).",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "sourceAccountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "cycle": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly", "custom"] },
        "monthlyDay": { "type": "number" },
        "customIntervalCount": { "type": "number" },
        "customIntervalUnit": { "type": "string" },
        "nextRunDate": { "type": "string" },
        "lastRunDate": { "type": "string" },
        "executionCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "note": { "type": "string" },
        "colorAccent": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "type", "amount", "sourceAccountId", "cycle", "nextRunDate", "isActive", "createdAt"]
    },
    "InvestmentAsset": {
      "title": "InvestmentAsset",
      "description": "Aset portofolio investasi pengguna.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "symbolOrTicker": { "type": "string" },
        "type": { "type": "string" },
        "platform": { "type": "string" },
        "initialCapital": { "type": "number" },
        "currentValue": { "type": "number" },
        "units": { "type": "number" },
        "buyPricePerUnit": { "type": "number" },
        "currentPricePerUnit": { "type": "number" },
        "colorAccent": { "type": "string" },
        "notes": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "closedAt": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "type", "initialCapital", "currentValue", "createdAt"]
    },
    "InvestmentEntry": {
      "title": "InvestmentEntry",
      "description": "Catatan arus dana (topup, yield, withdraw, close) pada aset investasi.",
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "ledgerId": { "type": "string" },
        "kind": { "type": "string", "enum": ["topup", "yield", "withdraw", "close"] },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "transactionId": { "type": "string" },
        "capitalDelta": { "type": "number" },
        "valueDelta": { "type": "number" },
        "capitalReduced": { "type": "number" },
        "realized": { "type": "number" },
        "closedAsset": { "type": "boolean" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["assetId", "ledgerId", "kind", "date", "amount", "accountId", "capitalDelta", "valueDelta", "createdAt"]
    },
    "AutopilotRule": {
      "title": "AutopilotRule",
      "description": "Aturan Autopilot untuk alokasi target, bayar tagihan, atau bayar cicilan otomatis.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["goal_topup", "pay_bill", "pay_debt"] },
        "targetId": { "type": "string" },
        "sourceAccountId": { "type": "string" },
        "amount": { "type": "number" },
        "cycle": { "type": "string" },
        "nextRunDate": { "type": "string" },
        "isActive": { "type": "boolean" },
        "lastRunDate": { "type": "string" },
        "executionCount": { "type": "number" },
        "lastError": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "name", "kind", "targetId", "sourceAccountId", "amount", "isActive", "createdAt"]
    },
    "CategoryBudget": {
      "title": "CategoryBudget",
      "description": "Pagu anggaran pengeluaran bulanan per kategori untuk satu buku kas.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "budgets": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "budgets", "updatedAt"]
    },
    "SalaryHistory": {
      "title": "SalaryHistory",
      "description": "Arsip periode gaji dan lembur bulanan.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "period": { "type": "string" },
        "totalOtHours": { "type": "number" },
        "totalMeals": { "type": "number" },
        "totalAddOns": { "type": "number" },
        "netSalary": { "type": "number" },
        "grossSalary": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "period", "totalOtHours", "totalMeals", "netSalary", "grossSalary", "createdAt"]
    },
    "ShiftSchedule": {
      "title": "ShiftSchedule",
      "description": "Log jadwal shift, lembur, dan ceklis makan untuk satu periode penggajian.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "periodKey": { "type": "string" },
        "days": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "periodKey", "days", "updatedAt"]
    },
    "SalaryAddOns": {
      "title": "SalaryAddOns",
      "description": "Daftar komponen tambahan gaji (THR, bonus, insentif) per bulan.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "monthKey": { "type": "string" },
        "addOns": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "monthKey", "addOns", "updatedAt"]
    },
    "SalarySettings": {
      "title": "SalarySettings",
      "description": "Konfigurasi gaji pokok, tunjangan, potongan, grup shift, dan auto-gajian.",
      "type": "object",
      "properties": {
        "ledgerId": { "type": "string" },
        "basicSalary": { "type": "number" },
        "housingAllowance": { "type": "number" },
        "shiftAllowance": { "type": "number" },
        "housingDeduction": { "type": "number" },
        "mealRate": { "type": "number" },
        "medicalBik": { "type": "number" },
        "ptkpStatus": { "type": "string" },
        "defaultGroup": { "type": "string" },
        "autoOTHoursPerSundayShift3": { "type": "number" },
        "isAutoOTEnabled": { "type": "boolean" },
        "payrollAuto": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ledgerId", "updatedAt"]
    },
    "UserSetting": {
      "title": "UserSetting",
      "description": "Preferensi pengguna, daftar kategori kustom, dan daftar hari libur nasional/kustom.",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "number" }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/ledgers/{ledgerId}": {
      "schema": { "$ref": "#/entities/Ledger" },
      "description": "Buku kas milik pengguna"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Akun/rekening keuangan milik pengguna"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Riwayat transaksi keuangan milik pengguna"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "Target tabungan dan sinking fund milik pengguna"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/Bill" },
      "description": "Tagihan rutin milik pengguna"
    },
    "/users/{userId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/Debt" },
      "description": "Utang dan cicilan milik pengguna"
    },
    "/users/{userId}/automations/{automationId}": {
      "schema": { "$ref": "#/entities/AutomationRule" },
      "description": "Aturan otomatisasi transaksi milik pengguna"
    },
    "/users/{userId}/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/InvestmentAsset" },
      "description": "Aset portofolio investasi milik pengguna"
    },
    "/users/{userId}/investmentEntries/{entryId}": {
      "schema": { "$ref": "#/entities/InvestmentEntry" },
      "description": "Riwayat arus dana investasi milik pengguna"
    },
    "/users/{userId}/autopilot/{ruleId}": {
      "schema": { "$ref": "#/entities/AutopilotRule" },
      "description": "Aturan Autopilot keuangan milik pengguna"
    },
    "/users/{userId}/budgets/{ledgerId}": {
      "schema": { "$ref": "#/entities/CategoryBudget" },
      "description": "Pagu anggaran kategori bulanan per buku kas"
    },
    "/users/{userId}/salaryHistory/{recordId}": {
      "schema": { "$ref": "#/entities/SalaryHistory" },
      "description": "Arsip perhitungan gaji dan lembur bulanan"
    },
    "/users/{userId}/shiftSchedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/ShiftSchedule" },
      "description": "Jadwal shift harian, lembur, dan ceklis makan"
    },
    "/users/{userId}/salaryAddons/{addonDocId}": {
      "schema": { "$ref": "#/entities/SalaryAddOns" },
      "description": "Komponen tambahan gaji (THR, bonus, insentif)"
    },
    "/users/{userId}/salarySettings/{ledgerId}": {
      "schema": { "$ref": "#/entities/SalarySettings" },
      "description": "Pengaturan komponen gaji dan jadwal otomatis"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSetting" },
      "description": "Dokumen singleton pengaturan (preferences, categories, holidays, migration, shift)"
    }
  }
}
