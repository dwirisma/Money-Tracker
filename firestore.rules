rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Akses penuh ke seluruh data Artha di users/user_artha hanya setelah login Firebase Auth
    match /users/user_artha {
      allow read, write: if request.auth != null;
    }

    match /users/user_artha/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Blokir seluruh path lainnya secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
