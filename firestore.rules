rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isLegacyDemoSource(userId) {
      return isAuthenticated() && userId == 'demo_user_artha';
    }

    function canReadUserDoc(userId) {
      return isOwner(userId) || isLegacyDemoSource(userId);
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] == null || data[key] is bool;
    }

    function isTimestampOrNumber(val) {
      return val is number || val is string || val is timestamp;
    }

    // =========================================================================
    // Domain Validators
    // =========================================================================
    function isValidLedger(data) {
      return isNonEmptyString(data.name, 120)
        && isOptionalString(data, 'description', 500)
        && isOptionalString(data, 'icon', 32)
        && isOptionalString(data, 'colorAccent', 32)
        && isOptionalBool(data, 'isDefault')
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidAccount(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 120)
        && data.type in ['bank', 'ewallet', 'cash', 'credit_card']
        && data.balance is number
        && isOptionalNumber(data, 'creditLimit')
        && isOptionalString(data, 'colorAccent', 32)
        && isOptionalBool(data, 'isArchived')
        && (!('pockets' in data) || data.pockets == null || (data.pockets is list && data.pockets.size() <= 100))
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidTransaction(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.accountId, 128)
        && data.type in ['income', 'expense', 'transfer']
        && data.amount is number && data.amount >= 0
        && isNonEmptyString(data.date, 32)
        && isOptionalString(data, 'toAccountId', 128)
        && isOptionalString(data, 'goalId', 128)
        && isOptionalString(data, 'billId', 128)
        && isOptionalString(data, 'debtId', 128)
        && isOptionalString(data, 'automationId', 128)
        && isOptionalString(data, 'category', 120)
        && isOptionalString(data, 'note', 1000)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidGoal(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 120)
        && data.type in ['wishlist', 'sinking_fund']
        && data.targetAmount is number && data.targetAmount >= 0
        && data.currentAmount is number && data.currentAmount >= 0
        && isOptionalString(data, 'deadline', 32)
        && isOptionalString(data, 'sourceAccountId', 128)
        && isOptionalString(data, 'colorAccent', 32)
        && isOptionalString(data, 'note', 1000)
        && isOptionalBool(data, 'isCompleted')
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidBill(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 120)
        && data.cycle in ['daily', 'weekly', 'monthly', 'yearly', 'custom']
        && data.pricingType in ['fixed', 'variable']
        && isNonEmptyString(data.nextPaymentDate, 32)
        && data.totalPaid is number && data.totalPaid >= 0
        && isOptionalNumber(data, 'customIntervalCount')
        && isOptionalString(data, 'customIntervalUnit', 32)
        && isOptionalNumber(data, 'fixedAmount')
        && isOptionalNumber(data, 'lastNominal')
        && isOptionalString(data, 'category', 120)
        && isOptionalString(data, 'sourceAccountId', 128)
        && isOptionalString(data, 'colorAccent', 32)
        && isOptionalString(data, 'note', 1000)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidDebt(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 120)
        && data.totalDebt is number && data.totalDebt >= 0
        && data.remainingDebt is number && data.remainingDebt >= 0
        && data.isPaidOff is bool
        && isOptionalString(data, 'lender', 120)
        && isOptionalString(data, 'nextPaymentDate', 32)
        && isOptionalString(data, 'cycle', 32)
        && isOptionalNumber(data, 'customIntervalCount')
        && isOptionalString(data, 'customIntervalUnit', 32)
        && isOptionalString(data, 'dueDate', 32)
        && isOptionalString(data, 'sourceAccountId', 128)
        && isOptionalString(data, 'colorAccent', 32)
        && isOptionalString(data, 'note', 1000)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidAutomation(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 160)
        && data.type in ['income', 'expense', 'transfer']
        && data.amount is number && data.amount >= 0
        && isNonEmptyString(data.sourceAccountId, 128)
        && data.cycle in ['daily', 'weekly', 'monthly', 'yearly', 'custom']
        && isNonEmptyString(data.nextRunDate, 32)
        && data.isActive is bool
        && isOptionalString(data, 'toAccountId', 128)
        && isOptionalString(data, 'category', 120)
        && isOptionalNumber(data, 'monthlyDay')
        && isOptionalNumber(data, 'customIntervalCount')
        && isOptionalString(data, 'customIntervalUnit', 32)
        && isOptionalString(data, 'lastRunDate', 32)
        && isOptionalNumber(data, 'executionCount')
        && isOptionalString(data, 'note', 1000)
        && isOptionalString(data, 'colorAccent', 32)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidInvestment(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 120)
        && data.type in ['stock', 'mutual_fund', 'crypto', 'gold', 'bond', 'deposit', 'p2p', 'other']
        && data.initialCapital is number && data.initialCapital >= 0
        && data.currentValue is number && data.currentValue >= 0
        && isOptionalString(data, 'symbolOrTicker', 32)
        && isOptionalString(data, 'platform', 120)
        && isOptionalNumber(data, 'units')
        && isOptionalNumber(data, 'buyPricePerUnit')
        && isOptionalNumber(data, 'currentPricePerUnit')
        && isOptionalString(data, 'colorAccent', 32)
        && isOptionalString(data, 'notes', 1000)
        && isOptionalString(data, 'lastUpdated', 32)
        && isOptionalString(data, 'status', 32)
        && isOptionalString(data, 'closedAt', 32)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidInvestmentEntry(data) {
      return isNonEmptyString(data.assetId, 128)
        && isNonEmptyString(data.ledgerId, 128)
        && data.kind in ['topup', 'yield', 'withdraw', 'close']
        && isNonEmptyString(data.date, 32)
        && data.amount is number && data.amount >= 0
        && isNonEmptyString(data.accountId, 128)
        && data.capitalDelta is number
        && data.valueDelta is number
        && isOptionalString(data, 'transactionId', 128)
        && isOptionalNumber(data, 'capitalReduced')
        && isOptionalNumber(data, 'realized')
        && isOptionalBool(data, 'closedAsset')
        && isOptionalString(data, 'note', 1000)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidAutopilot(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.name, 160)
        && data.kind in ['goal_topup', 'pay_bill', 'pay_debt']
        && isNonEmptyString(data.targetId, 128)
        && isNonEmptyString(data.sourceAccountId, 128)
        && data.amount is number && data.amount >= 0
        && data.isActive is bool
        && isOptionalString(data, 'cycle', 32)
        && isOptionalString(data, 'nextRunDate', 32)
        && isOptionalString(data, 'lastRunDate', 32)
        && isOptionalNumber(data, 'executionCount')
        && isOptionalString(data, 'lastError', 500)
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidBudgetDoc(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && data.budgets is map
        && ('updatedAt' in data) && isTimestampOrNumber(data.updatedAt);
    }

    function isValidSalaryHistory(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.period, 32)
        && data.totalOtHours is number
        && data.totalMeals is number
        && data.netSalary is number
        && data.grossSalary is number
        && isOptionalNumber(data, 'totalAddOns')
        && ('createdAt' in data) && isTimestampOrNumber(data.createdAt);
    }

    function isValidShiftSchedule(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.periodKey, 32)
        && data.days is list && data.days.size() <= 62
        && ('updatedAt' in data) && isTimestampOrNumber(data.updatedAt);
    }

    function isValidSalaryAddons(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && isNonEmptyString(data.monthKey, 32)
        && data.addOns is list && data.addOns.size() <= 100
        && ('updatedAt' in data) && isTimestampOrNumber(data.updatedAt);
    }

    function isValidSalarySettings(data) {
      return isNonEmptyString(data.ledgerId, 128)
        && ('updatedAt' in data) && isTimestampOrNumber(data.updatedAt);
    }

    function isValidSettingDoc(settingId, data) {
      return settingId in ['preferences', 'categories', 'holidays', 'migration', 'shift']
        && ('updatedAt' in data) && isTimestampOrNumber(data.updatedAt);
    }

    // =========================================================================
    // User-Scoped Private Collections (+ Read-Only Legacy Migration Source)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if false;

      match /ledgers/{ledgerId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidLedger(request.resource.data);
        allow update: if isOwner(userId) && isValidLedger(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /accounts/{accountId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidAccount(request.resource.data);
        allow update: if isOwner(userId) && isValidAccount(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidGoal(request.resource.data);
        allow update: if isOwner(userId) && isValidGoal(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /bills/{billId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidBill(request.resource.data);
        allow update: if isOwner(userId) && isValidBill(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /debts/{debtId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidDebt(request.resource.data);
        allow update: if isOwner(userId) && isValidDebt(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /automations/{automationId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidAutomation(request.resource.data);
        allow update: if isOwner(userId) && isValidAutomation(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /investments/{investmentId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidInvestment(request.resource.data);
        allow update: if isOwner(userId) && isValidInvestment(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /investmentEntries/{entryId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidInvestmentEntry(request.resource.data);
        allow update: if isOwner(userId) && isValidInvestmentEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /autopilot/{ruleId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidAutopilot(request.resource.data);
        allow update: if isOwner(userId) && isValidAutopilot(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /budgets/{ledgerId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidBudgetDoc(request.resource.data);
        allow update: if isOwner(userId) && isValidBudgetDoc(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /salaryHistory/{recordId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidSalaryHistory(request.resource.data);
        allow update: if isOwner(userId) && isValidSalaryHistory(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /shiftSchedules/{scheduleId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidShiftSchedule(request.resource.data);
        allow update: if isOwner(userId) && isValidShiftSchedule(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /salaryAddons/{addonDocId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidSalaryAddons(request.resource.data);
        allow update: if isOwner(userId) && isValidSalaryAddons(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /salarySettings/{ledgerId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidSalarySettings(request.resource.data);
        allow update: if isOwner(userId) && isValidSalarySettings(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if canReadUserDoc(userId);
        allow create: if isOwner(userId) && isValidSettingDoc(settingId, request.resource.data);
        allow update: if isOwner(userId) && isValidSettingDoc(settingId, request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Legacy snake_case subcollections under demo_user_artha (read-only for one-time migration)
      match /investment_entries/{entryId} {
        allow read: if isLegacyDemoSource(userId);
        allow write: if false;
      }

      match /salary_histories/{recordId} {
        allow read: if isLegacyDemoSource(userId);
        allow write: if false;
      }

      match /shift_schedules/{scheduleId} {
        allow read: if isLegacyDemoSource(userId);
        allow write: if false;
      }

      match /salary_addons/{addonDocId} {
        allow read: if isLegacyDemoSource(userId);
        allow write: if false;
      }

      match /salary_settings/{ledgerId} {
        allow read: if isLegacyDemoSource(userId);
        allow write: if false;
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
